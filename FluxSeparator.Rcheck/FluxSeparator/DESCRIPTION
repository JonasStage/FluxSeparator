Package: FluxSeparator
Title: Separation of Diffusive and Ebullitive Fluxes
Version: 1.0.1
Authors@R: c(
    person("Jonas Stage", "Sø", , "Jonassoe@biology.sdu.dk", role = c("aut", "cre"),
           comment = c(ORCID = "0000-0002-3222-3706")),
